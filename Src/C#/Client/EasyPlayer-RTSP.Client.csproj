<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinRtspPlayer</AssemblyName>
    <RootNamespace>WinRtspPlayer.Client</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Images\EasyPlayer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyPlayerNetSDK\EasyPlayer-RTSP.NetSDK.csproj" />
    <ProjectReference Include="..\WinRtspPlayer.Core\WinRtspPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native EasyPlayer-RTSP x86 runtime DLLs (excluding dxva2.dll, debug CRT DLLs, browser/OLE plugins) -->
    <None Include="..\Solution Items\Lib\avcodec-57.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\avdevice-57.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\avfilter-6.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\avformat-57.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\avutil-55.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\D3DRender.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\D3DX9_43.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\FFDecoder.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\IntelHardCodec.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\js.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libEasyAACEncoder.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libEasyPlayer-RTSP.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libEasyRTSPClient.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libeay32.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libgcc_s_sjlj-1.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libgpac.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libmfxsw32.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\libstdc++-6.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\ssleay32.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\swresample-2.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Solution Items\Lib\swscale-4.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- Microsoft-signed VC++ 2010 x86 runtime DLLs required by libEasyPlayer-RTSP -->
    <None Include="..\..\..\Bin\C++\msvcr100.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\Bin\C++\msvcp100.dll" Link="Lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
